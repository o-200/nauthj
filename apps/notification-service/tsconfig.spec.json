{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "resolvePackageJsonExports": false,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "@common/common": ["../../libs/common/src"],
      "@common/common/*": ["../../libs/common/src/*"],
      "@common/constants": ["../../libs/common/constants"],
      "@common/constants/*": ["../../libs/common/constants/*"],
    },
  },
  "include": ["src/**/*.ts", "src/**/*.spec.ts"],
}
